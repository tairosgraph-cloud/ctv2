{
  "name": "tairos-rc",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "description": "Tairos.rc — Asistente comercial: registro contable, proformas, deudas y arqueo de caja",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "smoke": "esbuild scripts/smoke.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/smoke.mjs --log-level=error --alias:@=./src --external:exceljs && node --input-type=module -e \"import('./scripts/browser-shim.js').then(() => import('./node_modules/.cache/smoke.mjs'))\""
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@fortawesome/fontawesome-free": "^6.7.2",
    "@supabase/supabase-js": "^2.45.4",
    "exceljs": "^4.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
