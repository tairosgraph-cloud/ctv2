# ============================================================================
# Variables del FRONTEND. Copia este archivo a .env.local y rellénalo.
#
# ⚠️  TODO lo que empiece por VITE_ acaba DENTRO del JavaScript que descarga
#     el navegador. No es un archivo de secretos: es la entrada del compilador
#     al código público. Nunca pongas aquí la clave secreta de Supabase ni la
#     contraseña de la base de datos.
#
#     Vite las incrusta AL COMPILAR: si las cambias, hay que volver a ejecutar
#     `npm run build` para que el sitio publicado se entere.
# ============================================================================

# Supabase → Settings → API
VITE_SUPABASE_URL=

# La clave PUBLICABLE (antes «anon»). Está diseñada para ser pública; lo que
# protege los datos no es esta clave, son las políticas RLS de la base.
VITE_SUPABASE_ANON_KEY=

# Nombre que queda registrado como autor de cada asiento contable.
VITE_APP_USER=

# ============================================================================
# Lo demás NO va aquí:
#
#   Contraseña de la base  →  ~/.pgpass, fuera del repositorio (permisos 600).
#                             psql la resuelve sola; imposible commitearla.
#
#   Conexión de migración  →  .env.db (ignorado por git), SIN contraseña.
#                             Ver scripts/migrate.mjs.
#
#   Clave secreta          →  tu gestor de contraseñas. La app nunca la usa.
# ============================================================================
